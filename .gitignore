# Neovim runtime / build artefacts
build/
.nvim/
plugin/
session/

# Logs
*.log
*-headless.log

# Local scratch and validation files
_neotree_theme_test.txt
nvim_validate

# Per-machine tool settings
.claude/settings.local.json

# Interrupted :TSInstall runs leave clones here; they block later installs
tree-sitter-*/

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# Editor backups
*.bak
*.swp
*.swo
*~

# NOTE: lazy-lock.json is deliberately NOT ignored. Committing it is what makes
# the plugin set reproducible across machines (`:Lazy restore`).
